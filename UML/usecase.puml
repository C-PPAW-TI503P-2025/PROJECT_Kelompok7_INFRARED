@startuml
left to right direction
skinparam packageStyle rectangle

' --- ACTORS (HANYA MANUSIA) ---
actor "User (Fisik)" as user
actor "Admin (Web)" as admin

rectangle "Sistem IoT Remote & Web (Monitoring)" {

    ' --- KELOMPOK FITUR USER ---
    usecase "Tekan Tombol Remote" as UC_Press
    usecase "Validasi Sinyal IR" as UC_Validate
    usecase "Simpan Data ke Firebase" as UC_Save
    usecase "Abaikan Sinyal (Error)" as UC_Error

    ' --- KELOMPOK FITUR ADMIN ---
    usecase "Login Admin" as UC_Login
    usecase "Logout" as UC_Logout
    usecase "Lupa Password" as UC_Forgot
    usecase "Lihat Dashboard" as UC_View
    usecase "Tampilkan Data Realtime" as UC_Display
}

' =========================================
' HUBUNGAN (ALUR LOGIKA)
' =========================================

' --- 1. SISI USER ---
user --> UC_Press

' INCLUDE: Tekan tombol -> Wajib Validasi
UC_Press ..> UC_Validate : <<include>>

' INCLUDE: Validasi sukses -> Wajib Simpan Data (Internal)
UC_Validate ..> UC_Save : <<include>>

' EXTEND: Jika kode salah -> Error
UC_Validate <.. UC_Error : <<extend>>


' --- 2. SISI ADMIN ---
' Admin bisa melakukan Login dan Logout
admin --> UC_Login
UC_Login <.. UC_Logout : <<extend>>

' EXTEND: Jika lupa sandi saat login
UC_Login <.. UC_Forgot : <<extend>>

' INCLUDE: Login sukses -> Langsung masuk Dashboard
UC_Login ..> UC_View : <<include>>

' INCLUDE: Saat Dashboard terbuka -> Sistem WAJIB menampilkan data
UC_View ..> UC_Display : <<include>>

' (Opsional) Logout dilakukan saat di Dashboard
' UC_View <.. UC_Logout : <<extend>> 
' Tapi ditarik garis langsung dari Admin (seperti di atas) lebih umum dan jelas.

@enduml