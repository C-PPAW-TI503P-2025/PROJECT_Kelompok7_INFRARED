@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho

title Class Diagram: Sistem Monitoring IoT (ESP32 + Obstacle + NTP)

' --- PAKET 1: FIRMWARE (ESP32 / C++) ---
package "Firmware (Hardware Logic)" {
    
    class "Obstacle_Sensor_Driver" as Sensor {
        - pin : int
        + setup() : void
        + readState() : int
        ' (Return: LOW/HIGH)
    }

    class "NTP_Time_Client" as TimeClient {
        - ntpServer : String
        - gmtOffset : long
        + configTime() : void
        + getJamSekarang() : String
        ' (Return: "dd/mm/yyyy, HH:mm:ss")
    }

    class "Main_Controller" as ESP32 {
        - wifi_ssid : String
        - firebase_host : String
        - status_terakhir : String
        --
        + setup() : void
        + loop() : void
        + connectToWiFi() : void
        + sendDataToFirebase(status, waktu) : void
    }
}

' --- PAKET 2: DATA LAYER (Sesuai ERD Terakhir) ---
package "Data Layer (Firebase)" {
    
    class "Admin" as AdminModel {
        + uid : String
        + email : String
        + password : String
    }

    class "Virtual_Object" as ObjModel {
        + node_key : String
        + status_sekarang : String
        + waktu_update : String
        + waktu_mulai_online : String
    }
    
    note bottom of ObjModel
        Tidak ada Remote_Log
        karena sistem menimpa data (Update)
    end note
}

' --- PAKET 3: WEB APPLICATION (FRONTEND / JS) ---
package "Web Application (Frontend)" {

    class "Dashboard_UI" as View {
        - visual_lampu : DOM_Element
        - text_status : DOM_Element
        --
        + initFirebaseListener() : void
        + updateTampilan(data) : void
        + checkOfflineStatus(lastSeenTime) : void
        ' (Logika hitung selisih 15 detik)
    }

    class "Auth_Manager" as Auth {
        + login(email, pass) : Promise
        + logout() : void
        + onAuthStateChanged() : void
    }
}

' ===================================
' HUBUNGAN ANTAR CLASS
' ===================================

' 1. Hubungan di Hardware
ESP32 "1" --> "1" Sensor : reads >
ESP32 "1" --> "1" TimeClient : gets time from >

' 2. Hubungan ke Data (Dependency)
' ESP32 mengupdate data status dan waktu ke model objek
ESP32 ..> ObjModel : updates (status & timestamp) >

' 3. Hubungan di Web
' Auth Manager mengurus login admin
Auth ..> AdminModel : authenticates >

' Dashboard butuh akses Auth (Login dulu)
View ..> Auth : requires session >

' Dashboard membaca data dari Virtual Object secara Realtime
View ..> ObjModel : subscribes/listens >

@enduml